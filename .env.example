# ─────────────────────────────────────────────────────────────────────────
# speed-to-lead-agent — configuration (bring your own keys)
#
# Copy to `.env` and fill in only what you need. EVERY key is optional:
# missing keys disable that one feature, they don't break the app. With no
# keys at all, run `make demo` (DEMO_MODE) — local stub model + console
# adapters, zero signups required.
# ─────────────────────────────────────────────────────────────────────────

# --- Runtime -------------------------------------------------------------
# DEMO_MODE=true forces the local stub LLM + console integrations (no keys).
DEMO_MODE=true
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- LLM (the draft step) — provider-agnostic via litellm ----------------
# Get a free key: Gemini → aistudio.google.com  |  Groq → console.groq.com
# Leave blank in DEMO_MODE; otherwise set provider + model + key.
LLM_PROVIDER=gemini            # gemini | groq | openai | anthropic | ollama
LLM_MODEL=gemini/gemini-1.5-flash
LLM_API_KEY=

# --- Webhook security ----------------------------------------------------
# Shared secret used to verify inbound webhook signatures (recommended).
WEBHOOK_SIGNING_SECRET=

# --- CRM (one of) --------------------------------------------------------
CRM_PROVIDER=console           # console | twenty | hubspot
# Twenty (self-hosted, https://twenty.com) — Settings → API
TWENTY_API_URL=
TWENTY_API_KEY=
# HubSpot — private app token
HUBSPOT_API_KEY=

# --- Notifications -------------------------------------------------------
# Slack incoming webhook → api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Email via Resend (resend.com) — free tier; leave blank to log to console
RESEND_API_KEY=
EMAIL_FROM=

# --- ATS / HRIS connector (recruiting-pipeline use-case) -----------------
# Greenhouse Harvest API key (accessible); Workday/SAP documented in docs/.
GREENHOUSE_API_KEY=
# Greenhouse requires a user id to act on behalf of (Harvest "On-Behalf-Of").
GREENHOUSE_ON_BEHALF_OF=

# --- Observability: Langfuse (LLM tracing) -------------------------------
# Free cloud or self-host (langfuse.com). Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Async worker + vector store -----------------------------------------
# Redis powers the async queue. In DEMO_MODE an in-memory queue is used.
REDIS_URL=redis://localhost:6379/0

# --- Classifier ----------------------------------------------------------
# Path to the fine-tuned LoRA adapter; falls back to rules if absent.
CLASSIFIER_ADAPTER_PATH=artifacts/intent-classifier

# --- Routing thresholds (0–1) -------------------------------------------
# Auto-send the drafted reply only above this qualification confidence.
AUTO_SEND_MIN_CONFIDENCE=0.75
