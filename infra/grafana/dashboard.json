{
  "title": "BuildSignal — Funnel & Response Speed",
  "uid": "buildsignal",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["buildsignal", "gtm"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Leads processed",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "buildsignal_leads_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Qualification rate",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" } },
      "targets": [{ "expr": "buildsignal_qualification_rate", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Response latency (ms)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "buildsignal_response_ms{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "buildsignal_response_ms{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Leads by tier",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "buildsignal_leads_by_tier", "legendFormat": "{{tier}}", "refId": "A" }
      ]
    }
  ]
}
